[Unit]
Description=Pi Reader — e-ink book reader
After=network.target
Wants=network.target

[Service]
Type=simple
User=miquel
WorkingDirectory=/home/miquel/pi-reader
ExecStart=/usr/bin/python3 /home/miquel/pi-reader/main.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
